<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Default Document -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Disable Directory Browsing to prevent directory harvesting/reconnaissance -->
    <directoryBrowse enabled="false" />

    <!-- Static Content Mime Types with Production Caching -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <!-- Enterprise Security HTTP Response Headers -->
    <httpProtocol>
      <customHeaders>
        <!-- Remove server identity banners -->
        <remove name="X-Powered-By" />

        <!-- Anti-MIME Sniffing -->
        <add name="X-Content-Type-Options" value="nosniff" />

        <!-- Anti-Clickjacking: Disallow framing outside same origin -->
        <add name="X-Frame-Options" value="SAMEORIGIN" />

        <!-- Cross-Site Scripting (XSS) Protection Filter -->
        <add name="X-XSS-Protection" value="1; mode=block" />

        <!-- Strict Transport Security (HSTS) - 1 Year, Subdomains, Preload -->
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains; preload" />

        <!-- Strict Referrer Policy: Prevents sensitive path leakage in outbound referrers -->
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />

        <!-- Browser Permissions Lockdown: Blocks unauthorized access to camera, mic, geolocation, payments -->
        <add name="Permissions-Policy" value="accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" />

        <!-- Content Security Policy (CSP): Hardens asset sources, scripts, and frame ancestors -->
        <add name="Content-Security-Policy" value="default-src 'self' data: https:; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https:; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://wa.me https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://wa.me;" />

        <!-- Cross-Origin Isolation -->
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
        <add name="Cross-Origin-Resource-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- Request Filtering: Block Attacker Probing & Malicious Injections -->
    <security>
      <requestFiltering allowDoubleEscaping="false" allowHighBitCharacters="false">
        <!-- Block Hidden Sensitive Directories -->
        <hiddenSegments>
          <add segment=".git" />
          <add segment=".env" />
          <add segment="node_modules" />
          <add segment="App_Data" />
          <add segment="bin" />
          <add segment=".vscode" />
          <add segment=".gemini" />
        </hiddenSegments>

        <!-- Block Exploitable File Extensions -->
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".git" allowed="false" />
          <add fileExtension=".jsonl" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".ps1" allowed="false" />
          <add fileExtension=".bat" allowed="false" />
          <add fileExtension=".cmd" allowed="false" />
          <add fileExtension=".sh" allowed="false" />
          <add fileExtension=".php" allowed="false" />
          <add fileExtension=".asp" allowed="false" />
          <add fileExtension=".aspx" allowed="false" />
          <add fileExtension=".exe" allowed="false" />
          <add fileExtension=".dll" allowed="false" />
        </fileExtensions>

        <!-- Block Common Exploit Query Patterns -->
        <filteringRules>
          <filterRule name="BlockSQLiAndXSSProbes" scanUrl="false" scanQueryString="true">
            <scanHeaders>
              <clear />
            </scanHeaders>
            <appliesTo>
              <clear />
            </appliesTo>
            <denyStrings>
              <add string="union select" />
              <add string="drop table" />
              <add string="insert into" />
              <add string="select from" />
              <add string="&lt;script" />
              <add string="javascript:" />
              <add string="../" />
              <add string="..\." />
              <add string="/etc/passwd" />
              <add string="cmd.exe" />
            </denyStrings>
          </filterRule>
        </filteringRules>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
